# Copy this file to .env and fill in real values. .env should NOT be
# committed -- add it to .gitignore if it isn't covered already.

# Same values as SUPABASE_URL / SUPABASE_ANON_KEY near the bottom of
# index.html -- the anon key is safe here, it's the same public key the app
# itself ships with.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Three real accounts, already signed up through the app, with roles
# already assigned the normal way (an existing admin/manager uses the
# Manager Dashboard's "Assign a role" panel -- or, for the very first admin,
# set directly in Supabase). Password reset / signup isn't part of this
# suite; these accounts need to already exist and be able to log in.
TEST_CUSTOMER_EMAIL=customer-test@example.com
TEST_CUSTOMER_PASSWORD=

TEST_MANAGER_EMAIL=manager-test@example.com
TEST_MANAGER_PASSWORD=

TEST_ADMIN_EMAIL=admin-test@example.com
TEST_ADMIN_PASSWORD=
